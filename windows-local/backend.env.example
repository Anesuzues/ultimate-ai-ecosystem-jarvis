# Backend env — copy to ..\backend\.env
MONGO_URL=mongodb://localhost:27017
DB_NAME=jarvis_db

# Get a free key at https://emergent.sh (or paste your own OpenAI key — the universal key starts with sk-emergent-)
EMERGENT_LLM_KEY=

# Pick the brain: emergent (cloud) or ollama (local)
LLM_PROVIDER=emergent

# Used only when LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

CORS_ORIGINS=*
