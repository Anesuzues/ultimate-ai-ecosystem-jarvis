# Frontend env — copy to ..\frontend\.env
# Replace 192.168.1.42 with your Windows PC's LAN IP (run "ipconfig" to find it).
# To use only on this same PC, leave http://localhost:8001 — but then you can't access from your phone.
REACT_APP_BACKEND_URL=http://192.168.1.42:8001

# Disable react-scripts host check so phones on the LAN can connect
HOST=0.0.0.0
PORT=3000
DANGEROUSLY_DISABLE_HOST_CHECK=true
WDS_SOCKET_PORT=0
