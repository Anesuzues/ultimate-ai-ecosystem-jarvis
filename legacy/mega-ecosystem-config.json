{
  "name": "MEGA AI Development Ecosystem",
  "version": "1.0.0",
  "description": "Ultimate integration of 5 AI systems",
  "systems": {
    "anx": {
      "enabled": true,
      "type": "terminal_ai",
      "location": "terminal",
      "capabilities": [
        "coding",
        "analysis",
        "debugging"
      ]
    },
    "claw_code": {
      "enabled": true,
      "type": "ai_dev_environment",
      "location": "claw-code/",
      "ollama_integration": true,
      "models": [
        "qwen2.5-coder:7b",
        "local",
        "code"
      ]
    },
    "ollama": {
      "enabled": true,
      "type": "local_ai_engine",
      "endpoint": "http://localhost:11434",
      "models": [
        "qwen2.5-coder:7b",
        "llama3.2:3b"
      ]
    },
    "superagent": {
      "enabled": true,
      "type": "workflow_coordinator",
      "location": "bot-anx/",
      "database": "supabase",
      "port": 8001
    },
    "godmode": {
      "enabled": true,
      "type": "personal_ai_os",
      "location": "godmode-main/",
      "agents": 35,
      "port": 18789
    }
  },
  "routing": {
    "strategy": "intelligent_routing",
    "rules": {
      "coding_tasks": [
        "claw_code",
        "anx"
      ],
      "research_tasks": [
        "godmode",
        "superagent"
      ],
      "coordination_tasks": [
        "superagent",
        "godmode"
      ],
      "terminal_tasks": [
        "anx",
        "claw_code"
      ],
      "team_tasks": [
        "godmode",
        "superagent"
      ]
    }
  },
  "data_flow": {
    "local_processing": [
      "anx",
      "claw_code",
      "ollama"
    ],
    "cloud_coordination": [
      "superagent",
      "godmode"
    ],
    "real_time_sync": "supabase",
    "privacy_level": "local_first"
  },
  "workflows": {
    "ticket_to_deployment": {
      "steps": [
        "clickup",
        "superagent",
        "claw_code",
        "godmode",
        "github",
        "vercel"
      ],
      "coordination": "superagent",
      "execution": "claw_code",
      "qa": "godmode"
    },
    "research_to_implementation": {
      "steps": [
        "godmode",
        "anx",
        "claw_code",
        "superagent"
      ],
      "research": "godmode",
      "analysis": "anx",
      "coding": "claw_code",
      "integration": "superagent"
    }
  }
}